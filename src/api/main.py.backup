@app.route('/api/admin/stats')
@admin_required
def admin_stats():
    """Retourne les statistiques pour le dashboard admin."""
    try:
        stats = {
            'nb_interactions': 0,
            'nb_users': 2,
            'rmse': None,
            'precision_at_10': None,
            'dernier_entrainement': None,
            'revenue_total': 0,
            'recommandations_servies': 0,
        }

        # Lire les métriques du modèle
        metrics_file = os.path.join(MODELS_DIR, 'metrics.json')
        if os.path.exists(metrics_file):
            with open(metrics_file, 'r', encoding='utf-8') as f:
                metrics = json.load(f)
                stats.update(metrics)

        # Compter les interactions
        if os.path.exists(INTERACTIONS_FILE):
            with open(INTERACTIONS_FILE, 'r', encoding='utf-8') as f:
                reader = csv.reader(f)
                next(reader, None)  # skip header
                stats['nb_interactions'] = sum(1 for _ in reader)

        return jsonify(stats)
    except Exception as e:
        return jsonify({'error': str(e)}), 500


@app.route('/api/admin/retrain', methods=['POST'])
@admin_required
def admin_retrain():
    """Lance le réentraînement du modèle ALS en arrière-plan."""
    try:
        import subprocess
        train_script = os.path.join(BASE_DIR, 'src', 'models', 'train_als.py')
        if not os.path.exists(train_script):
            return jsonify({'error': 'Script train_als.py introuvable'}), 404

        subprocess.Popen(
            ['python', train_script],
            stdout=open(os.path.join(MODELS_DIR, 'retrain_log.txt'), 'w'),
            stderr=subprocess.STDOUT
        )
        return jsonify({'status': 'ok', 'message': 'Réentraînement lancé en arrière-plan'}), 202
    except Exception as e:
        return jsonify({'error': str(e)}), 500


