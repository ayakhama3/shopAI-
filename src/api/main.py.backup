@app.route('/api/products', methods=['GET'])
def get_products_admin():
    """Liste tous les produits pour l'admin (avec stats)."""
    try:
        q = request.args.get('q', '')
        category = request.args.get('category', '')
        page = request.args.get('page', 1, type=int)
        per_page = request.args.get('per_page', 12, type=int)

        query = Product.query
        if q:
            query = query.filter(Product.name.ilike(f'%{q}%'))
        if category:
            query = query.filter(Product.category.ilike(category))

        total = query.count()
        products = query.offset((page - 1) * per_page).limit(per_page).all()

        result = []
        for p in products:
            try:
                meta = json.loads(p.product_metadata) if p.product_metadata else {}
            except Exception:
                meta = {}
            result.append({
                'id': p.id,
                'external_id': p.external_id,
                'name': p.name,
                'price': p.price,
                'category': p.category,
                'image': meta.get('image_url', 'https://placehold.co/400x400?text=Produit'),
                'rating': meta.get('rating', 4.5),
                'vendor': meta.get('vendor', 'ShopAI Store'),
                'stock': meta.get('stock', 99),
                'sales': meta.get('sales', 0),
                'status': meta.get('status', 'in_stock'),
            })

        return jsonify({
            'products': result,
            'total': total,
            'page': page,
            'per_page': per_page,
            'pages': (total + per_page - 1) // per_page,
        }), 200
    except Exception as e:
        return jsonify({'error': str(e)}), 500


@app.route('/api/products', methods=['POST'])
def create_product():
    """Crée un nouveau produit (admin)."""
    user = _get_auth_user()
    if not user or user.role != 'admin':
        return jsonify({'error': 'Admin required'}), 403

    data = request.get_json(silent=True) or {}
    try:
        meta = {
            'image_url': data.get('image', ''),
            'rating': 4.5,
            'vendor': 'ShopAI Store',
            'stock': int(data.get('stock', 0)),
            'sales': 0,
            'status': data.get('status', 'in_stock'),
            'description': data.get('description', ''),
            'ref': data.get('ref', ''),
        }
        product = Product(
            name=data.get('name'),
            price=float(data.get('price', 0)),
            category=data.get('category', 'Tech'),
            product_metadata=json.dumps(meta),
        )
        db.session.add(product)
        db.session.commit()
        return jsonify({'status': 'ok', 'id': product.id, 'message': 'Produit créé'}), 201
    except Exception as e:
        db.session.rollback()
        return jsonify({'error': str(e)}), 500


@app.route('/api/products/<int:product_id>', methods=['PUT'])
def update_product(product_id):
    """Met à jour un produit (admin)."""
    user = _get_auth_user()
    if not user or user.role != 'admin':
        return jsonify({'error': 'Admin required'}), 403

    product = Product.query.get(product_id)
    if not product:
        return jsonify({'error': 'Produit introuvable'}), 404

    data = request.get_json(silent=True) or {}
    try:
        meta = json.loads(product.product_metadata) if product.product_metadata else {}
        if 'name' in data:
            product.name = data['name']
        if 'price' in data:
            product.price = float(data['price'])
        if 'category' in data:
            product.category = data['category']
        if 'image' in data:
            meta['image_url'] = data['image']
        if 'stock' in data:
            meta['stock'] = int(data['stock'])
        if 'status' in data:
            meta['status'] = data['status']
        if 'description' in data:
            meta['description'] = data['description']
        product.product_metadata = json.dumps(meta)
        db.session.commit()
        return jsonify({'status': 'ok', 'message': 'Produit mis à jour'}), 200
    except Exception as e:
        db.session.rollback()
        return jsonify({'error': str(e)}), 500


@app.route('/api/products/<int:product_id>', methods=['DELETE'])
def delete_product(product_id):
    """Supprime un produit (admin)."""
    user = _get_auth_user()
    if not user or user.role != 'admin':
        return jsonify({'error': 'Admin required'}), 403

    product = Product.query.get(product_id)
    if not product:
        return jsonify({'error': 'Produit introuvable'}), 404

    try:
        db.session.delete(product)
        db.session.commit()
        return jsonify({'status': 'ok', 'message': 'Produit supprimé'}), 200
    except Exception as e:
        db.session.rollback()
        return jsonify({'error': str(e)}), 500


@app.route('/api/admin/stats/full')
def admin_stats_full():
    """Stats complètes depuis la DB pour le dashboard admin."""
    user = _get_auth_user()
    if not user or user.role != 'admin':
        return jsonify({'error': 'Admin required'}), 403

    try:
        nb_users = User.query.count()
        nb_products = Product.query.count()
        nb_orders = Order.query.count()
        nb_interactions = Interaction.query.count()

        # Revenus totaux
        revenue = db.session.query(db.func.sum(Order.total)).filter(
            Order.status.in_(['paid', 'created'])
        ).scalar() or 0

        # Commandes récentes (10 dernières)
        recent_orders = Order.query.order_by(Order.created_at.desc()).limit(10).all()
        orders_data = []
        for o in recent_orders:
            user_obj = User.query.get(o.user_id) if o.user_id else None
            orders_data.append({
                'id': o.id,
                'reference': f'ORD-{o.id:04d}',
                'user': user_obj.username if user_obj else 'Anonyme',
                'total': o.total,
                'status': o.status,
                'date': o.created_at.strftime('%d %b %Y') if o.created_at else '—',
            })

        # Répartition par catégorie
        from sqlalchemy import func
        categories = db.session.query(
            Product.category, func.count(Product.id)
        ).group_by(Product.category).all()

        return jsonify({
            'nb_users': nb_users,
            'nb_products': nb_products,
            'nb_orders': nb_orders,
            'nb_interactions': nb_interactions,
            'revenue_total': round(float(revenue), 2),
            'recent_orders': orders_data,
            'categories': [{'name': c[0] or 'Autre', 'count': c[1]} for c in categories],
        }), 200
    except Exception as e:
        return jsonify({'error': str(e)}), 500


@app.route('/api/admin/orders', methods=['GET'])
def admin_get_orders():
    """Toutes les commandes pour l'admin."""
    user = _get_auth_user()
    if not user or user.role != 'admin':
        return jsonify({'error': 'Admin required'}), 403

    page = request.args.get('page', 1, type=int)
    per_page = request.args.get('per_page', 10, type=int)
    status_filter = request.args.get('status', '')

    query = Order.query.order_by(Order.created_at.desc())
    if status_filter:
        query = query.filter(Order.status == status_filter)

    total = query.count()
    orders = query.offset((page - 1) * per_page).limit(per_page).all()

    result = []
    for o in orders:
        user_obj = User.query.get(o.user_id) if o.user_id else None
        result.append({
            'id': o.id,
            'reference': f'ORD-{o.id:04d}',
            'user': user_obj.username if user_obj else 'Anonyme',
            'email': user_obj.email if user_obj else '—',
            'total': o.total,
            'status': o.status,
            'date': o.created_at.strftime('%d %b %Y %H:%M') if o.created_at else '—',
        })

    return jsonify({
        'orders': result,
        'total': total,
        'page': page,
        'pages': (total + per_page - 1) // per_page,
    }), 200


@app.route('/api/admin/orders/<int:order_id>/status', methods=['PUT'])
def admin_update_order_status(order_id):
    """Met à jour le statut d'une commande (admin)."""
    user = _get_auth_user()
    if not user or user.role != 'admin':
        return jsonify({'error': 'Admin required'}), 403

    order = Order.query.get(order_id)
    if not order:
        return jsonify({'error': 'Commande introuvable'}), 404

    data = request.get_json(silent=True) or {}
    new_status = data.get('status')
    if not new_status:
        return jsonify({'error': 'status requis'}), 400

    try:
        order.status = new_status
        db.session.commit()
        return jsonify({'status': 'ok', 'message': f'Commande #{order_id} → {new_status}'}), 200
    except Exception as e:
        db.session.rollback()
        return jsonify({'error': str(e)}), 500
